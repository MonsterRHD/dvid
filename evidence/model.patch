+// expectStale asserts err wraps ErrResolveStale.
+func expectStale(t *testing.T, err error) {
+	t.Helper()
+	if !errors.Is(err, ErrResolveStale) {
+		t.Fatalf("expected ErrResolveStale, got %v", err)
+	}
