+				}
+			}()
+			wg.Add(1)
+			go func() { // G2: LimitVersions (repoMutex -> idMutex)
+				defer wg.Done()
+				<-barrier
+				time.Sleep(time.Duration(rand.Intn(5000)) * time.Microsecond)
