+func TestClient_AbortAfterFailure(t *testing.T) {
+	addr := freeAddr(t)
+	startTestServer(t, addr)
+	defer StopServer(addr)
+
+	s := newClientSession(t, addr, testPushMessage)
+	deliver(t, s, 1)
+	if err := s.Abort(); err != nil {
