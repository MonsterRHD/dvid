+	if !s.Aborted() {
+		t.Fatal("Aborted() should be true")
+	}
+	if err := s.Abort(); err != nil {
+		t.Fatalf("duplicate Abort should be idempotent, got %v", err)
+	}
+	h := handlerFor(t, s.ID())
+	if _, closed, _ := h.snapshot(); closed {
+		t.Fatal("aborted session must not be closed on the server")
+	}
